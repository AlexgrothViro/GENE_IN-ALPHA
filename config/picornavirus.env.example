# Gene-In default pipeline configuration.
# This file does not contain secrets and is safe to version.

# --- Configuracao basica ---
ASSEMBLER=spades
DB=ptv
BLAST_EVALUE=1e-5
BLAST_MAX_TARGET_SEQS=20

# --- Filtro de hospedeiro ---
HOST_FILTER_ENABLED=true
HOST_NAME="Sus scrofa"
HOST_ACCESSION="GCF_000003025.6"
HOST_INDEX_PREFIX="${REPO_ROOT}/ref/host/sus_scrofa_bt2"

# --- Recursos ---
THREADS=4

# --- Rede ---
BIND_HOST="127.0.0.1"
PORT="8000"

# --- Configuracao avancada ---
SPADES_MEMORY=64
SPADES_PARAMS="-m ${SPADES_MEMORY}"

VELVET_K=31
MIN_CONTIG_LEN=50
VELVET_OPTS=""
READ_TRKG=yes

# --- Amostra / diretorios ---
SAMPLE_NAME="amostra_teste"
SAMPLE_ID="amostra_teste"
RAW_DIR="data/raw"
BLAST_DB="blastdb/ptv"
HOST_REMOVED_DIR="data/host_removed"

# DB_QUERY="\"Teschovirus\"[Organism]"
